# Model: set EITHER the OpenAI-compatible trio (Gemini, Groq, OpenRouter...) OR ANTHROPIC_API_KEY.
# If both are set, the OpenAI-compatible trio wins.
# Gemini example:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

ANTHROPIC_API_KEY=

# Optional: override the model (default claude-sonnet-5-5)
# ANTHROPIC_MODEL=

# Optional: create real GitHub Issues on confirm. If either is empty, a mock tracker is used.
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# Optional: SQLite file location (default ./data/followthrough.db)
# DATABASE_PATH=
